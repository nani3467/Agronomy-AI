# ==============================================================================
# Agronomy AI — Backend Environment Configuration Example
# Copy this file to .env and set your credentials. Never commit .env to git.
# ==============================================================================

SECRET_KEY=django-insecure-your-secret-key-change-this-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Database Configuration
# ==============================================================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=greenguardian

# ==============================================================================
# Gnani AI API Configuration (Vachana Speech Platform)
# ==============================================================================
# Generate your API key at Gnani AI / Vachana platform (key format: vach_...)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0

# ==============================================================================
# Google Gemini Multimodal API (Only LLM Reasoning Provider)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Machine Learning Model Configuration
# ==============================================================================
HF_DISEASE_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
ENABLE_ML_DISEASE_MODEL=True
